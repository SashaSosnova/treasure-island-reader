rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Планировщик (book / kid-sheduler)
    match /families/{familyCode} {
      allow read, write: if request.auth != null;
    }

    // Том Сойер — не удалять при деплое правил
    match /tomSawyerFamilies/{familyCode} {
      allow read, write: if request.auth != null;
    }

    // Остров сокровищ
    match /treasureIslandFamilies/{familyCode} {
      allow read, write: if request.auth != null;
    }
  }
}
